{
  "name": "@dhee_ai/runner-boogu",
  "version": "0.1.0",
  "description": "Boogu image-edit runner for Dhee (comfy.boogu): prompt + up to 4 reference images into a ComfyUI Boogu edit workflow on a local GPU.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "dhee-runner"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dhee": {
    "runners": "./dist/index.js"
  },
  "files": [
    "dist",
    "runner.json",
    "workflows",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dheeai/runner-sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dheeai/dhee-runner-boogu.git"
  },
  "homepage": "https://github.com/dheeai/dhee-runner-boogu#readme",
  "publishConfig": { "access": "public" }
}